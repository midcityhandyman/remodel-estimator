# Optional settings. The app runs with none of these set.
# There are no secrets or API keys: everything runs offline.
# The app reads these from the process environment (it does not load .env files itself).

# Host and port for: python -m remodel_estimator serve
REMODEL_HOST=127.0.0.1
REMODEL_PORT=8000

# Path to your own price book JSON. Leave unset to use the bundled SAMPLE price book.
# REMODEL_PRICE_BOOK=data/my_price_book.json
